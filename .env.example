# Copy to .env. Every setting is optional; the defaults run fully locally with no API key.

# Storage. SQLite needs no setup; Postgres + pgvector is what docker-compose uses.
CITEWISE_DATABASE_URL=sqlite:///data/citewise.db
# CITEWISE_DATABASE_URL=postgresql://citewise:citewise@localhost:5433/citewise

# Retrieval. Models download once (about 200 MB) into ~/.cache/fastembed.
CITEWISE_EMBEDDING_MODEL=fastembed:BAAI/bge-small-en-v1.5
CITEWISE_RERANKER_MODEL=fastembed:Xenova/ms-marco-MiniLM-L-6-v2
CITEWISE_RETRIEVAL_MODE=hybrid

# Answers. "extractive" quotes the best sentences and needs no LLM.
# Groq has a free tier: https://console.groq.com/keys
CITEWISE_LLM_PROVIDER=extractive
# CITEWISE_LLM_PROVIDER=groq
# CITEWISE_LLM_API_KEY=gsk_...
# CITEWISE_LLM_MODEL=openai/gpt-oss-120b
#
# Fully local with Ollama (ollama pull llama3.2):
# CITEWISE_LLM_PROVIDER=ollama
# CITEWISE_LLM_MODEL=llama3.2

# Refuse before calling the LLM when the best source scores below this (see `make eval`).
CITEWISE_ABSTAIN_MIN_RERANK=0.01

# "demo" uses the API keys in config/access.yaml and lets the UI switch users.
CITEWISE_AUTH_MODE=demo
CITEWISE_LOG_JSON=false
